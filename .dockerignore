
# Ignore git metadata
/.git

# Node modules (anywhere)
node_modules
**/node_modules

# Environment files (don't include secrets in images)
.env
.env.*

# Local docker and build files
.dockerignore
Dockerfile
docker-compose.yml
fly.toml

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Build outputs
dist
build
out
.next
coverage

# Editor directories and files
.vscode
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# OS files
.DS_Store
Thumbs.db
